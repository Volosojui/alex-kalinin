---
import { getContent, type Locale } from '../i18n/content';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const { jobs } = t.journey;
---

<Section id="experience" title={t.nav.journey}>
  <div class="space-y-16">
    {
      jobs.map((job) => (
        <article>
          <div class="font-mono text-sm text-muted">
            <span>{job.period}</span>
            {job.location && <span class="text-muted/70"> · {job.location}</span>}
          </div>

          <div class="mt-4">
            <h3 class="text-lg font-medium tracking-tight">
              {
                job.url ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="underline decoration-line underline-offset-4 transition-colors hover:decoration-content"
                  >
                    {job.company}
                  </a>
                ) : (
                  job.company
                )
              }
              <span class="text-muted"> · {job.role}</span>
            </h3>

            <ul class="mt-6 space-y-3 text-base leading-relaxed text-content/90">
              {job.highlights.map((h) => (
                <li class="relative pl-6">
                  <span class="absolute left-0 top-3 h-px w-3 bg-muted/60" aria-hidden="true" />
                  <Fragment set:html={h} />
                </li>
              ))}
            </ul>

            {job.tags && (
              <p class="mt-6 font-mono text-sm leading-7 text-muted/70">{job.tags.join('  ·  ')}</p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
