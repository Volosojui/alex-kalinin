---
import Container from './Container.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section>
  <Container class="py-10 sm:py-14">
    <header class="mb-10 sm:mb-14">
      <h2 class="text-lg font-normal tracking-tight text-content">{title}</h2>
    </header>
    <slot />
  </Container>
</section>
