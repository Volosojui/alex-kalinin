---
import SectionContainer from './SectionContainer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section>
  <SectionContainer>
    <header class="mb-10 sm:mb-14">
      <h2 class="text-lg font-normal tracking-tight text-content">{title}</h2>
    </header>
    <slot />
  </SectionContainer>
</section>
