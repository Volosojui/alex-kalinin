---
import { getContent, type Locale } from '../i18n/content';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const { groups } = t.skills;
---

<Section id="skills" title={t.nav.skills}>
  <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      groups.map((group) => (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-wider text-muted">{group.title}</h3>
          <ul class="mt-4 space-y-1.5 text-sm text-content/90">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
