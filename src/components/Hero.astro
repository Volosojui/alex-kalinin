---
import { getContent, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);

const metaItems = [t.hero.availability, t.hero.location].flatMap((s) =>
  s.split(' · '),
);
---

<section id="top" class="mx-auto max-w-3xl px-6 pt-10 pb-10 sm:px-8 sm:pt-14 sm:pb-14">
  <div class="max-w-2xl">
    <h1 class="sr-only">{t.hero.name}, {t.hero.role}</h1>

    <div class="max-w-xl space-y-4 text-lg leading-relaxed text-content/90">
      {t.hero.summary.map((line) => <p>{line}</p>)}
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
      {
        metaItems.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{item}</span>
          </>
        ))
      }
    </p>
  </div>
</section>
