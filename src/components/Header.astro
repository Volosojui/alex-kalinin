---
import { getContent, type Locale } from '../i18n/content';
import avatar from '../assets/avatar.jpeg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);

const langs: { code: Locale; href: string; label: string }[] = [
  { code: 'en', href: '/', label: 'EN' },
  { code: 'ru', href: '/ru/', label: 'RU' },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 mx-auto max-w-3xl bg-transparent px-6 pt-8 pb-4 transition-[translate,padding,background-color] duration-300 ease-out will-change-transform sm:px-8 sm:pt-10 sm:pb-5 motion-reduce:transition-none"
>
  <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
    <a href="#top" class="flex w-full min-w-0 items-center gap-3 pr-12 leading-tight sm:w-auto sm:pr-0">
      <img
        src={avatar.src}
        alt={t.hero.name}
        width="56"
        height="56"
        class="h-14 w-14 shrink-0 rounded-full object-cover"
      />
      <span class="min-w-0">
        <span class="block truncate text-lg font-semibold tracking-tight">{t.hero.name}</span>
        <span class="block truncate text-base text-muted">{t.hero.role}</span>
      </span>
    </a>

    <div class="flex items-center gap-3">
      <div class="flex items-center rounded-full bg-content/5 p-0.5 font-mono text-sm">
        {
          langs.map((lang) => (
            <a
              href={lang.href}
              hreflang={lang.code}
              aria-current={lang.code === locale ? 'true' : undefined}
              class:list={[
                'rounded-full px-3.5 py-1.5 transition-colors',
                lang.code === locale
                  ? 'bg-bg text-content'
                  : 'text-muted hover:text-content',
              ]}
            >
              {lang.label}
            </a>
          ))
        }
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle absolute right-6 top-8 grid h-9 w-9 cursor-pointer place-items-center rounded-full text-muted transition-colors hover:bg-content/5 hover:text-content sm:static sm:right-auto sm:top-auto"
        aria-label={t.theme.toDark}
        title={t.theme.toDark}
        data-to-dark={t.theme.toDark}
        data-to-light={t.theme.toLight}
      >
        <svg class="theme-icon theme-icon--sun col-start-1 row-start-1 h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.95 6.95-1.41-1.41M6.46 6.46 5.05 5.05m12.49 0-1.41 1.41M6.46 17.54l-1.41 1.41" />
          <circle cx="12" cy="12" r="4" />
        </svg>
        <svg class="theme-icon theme-icon--moon col-start-1 row-start-1 h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  function syncLabel() {
    if (!toggle) return;
    const isDark = root.classList.contains('dark');
    const label = toggle.getAttribute(isDark ? 'data-to-light' : 'data-to-dark');
    if (label) {
      toggle.setAttribute('aria-label', label);
      toggle.setAttribute('title', label);
    }
  }

  toggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    syncLabel();
  });

  // Hide header on scroll down, reveal on scroll up
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const goingDown = y > lastY;

      // Solid background + tighter top padding once scrolled off the top
      if (y > 0) {
        header.classList.add('bg-bg', 'pt-4', 'sm:pt-5');
        header.classList.remove('bg-transparent', 'pt-8', 'sm:pt-10');
      } else {
        header.classList.add('bg-transparent', 'pt-8', 'sm:pt-10');
        header.classList.remove('bg-bg', 'pt-4', 'sm:pt-5');
      }

      if (goingDown && y > header.offsetHeight) {
        header.classList.add('-translate-y-full');
      } else {
        header.classList.remove('-translate-y-full');
      }
      lastY = y;
      ticking = false;
    };

    update();

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
